{
  "openapi": "3.0.0",
  "info": {
    "title": "PinStack API",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "github",
      "x-displayName": "GitHub",
      "description": "PinStack generates beautiful, embeddable SVG cards for dev platforms like GitHub."
    }
  ],
  "servers": [
    {
      "url": "https://pinstack.matheesha.workers.dev",
      "description": "Production"
    }
  ],
  "components": {
    "schemas": {

    },
    "parameters": {

    }
  },
  "paths": {
    "/github/repo/{owner}/{repo}": {
      "get": {
        "operationId": "getRepositoryCard",
        "tags": [
          "github"
        ],
        "summary": "Generate a repository SVG card",
        "description": "Generates an SVG card containing information about a public GitHub repository. The returned SVG can be embedded directly in Markdown, HTML, or other applications that support SVG images.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "The GitHub username or organization that owns the repository.",
              "example": "m4theesha"
            },
            "required": true,
            "description": "The GitHub username or organization that owns the repository.",
            "name": "owner",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "description": "The name of the GitHub repository.",
              "example": "pinstack"
            },
            "required": true,
            "description": "The name of the GitHub repository.",
            "name": "repo",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "github_dark",
                "github_light",
                "dracula",
                "alucard",
                "solarized",
                "catppuccin_latte",
                "catppuccin_frappe",
                "catppuccin_macchiato",
                "catppuccin_mocha",
                "rosepine",
                "monokai"
              ],
              "default": "github_dark",
              "description": "Color theme for the generated card.",
              "example": "github_light"
            },
            "required": false,
            "description": "Color theme for the generated card.",
            "name": "theme",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "SVG repository card generated successfully.",
            "content": {
              "image/svg+xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "The specified GitHub repository could not be found.",
            "content": {
              "image/svg+xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/github/user/{username}": {
      "get": {
        "operationId": "getUserCard",
        "tags": [
          "github"
        ],
        "summary": "Generate a user profile SVG card",
        "description": "Generates an SVG card containing information about a public GitHub user profile. The returned SVG can be embedded directly in Markdown, HTML, or other applications that support SVG images.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "The GitHub username whose profile card should be generated.",
              "example": "torvalds"
            },
            "required": true,
            "description": "The GitHub username whose profile card should be generated.",
            "name": "username",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "github_dark",
                "github_light",
                "dracula",
                "alucard",
                "solarized",
                "catppuccin_latte",
                "catppuccin_frappe",
                "catppuccin_macchiato",
                "catppuccin_mocha",
                "rosepine",
                "monokai"
              ],
              "default": "github_dark",
              "description": "Color theme for the generated card.",
              "example": "github_light"
            },
            "required": false,
            "description": "Color theme for the generated card.",
            "name": "theme",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "SVG user profile card generated successfully.",
            "content": {
              "image/svg+xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "The specified GitHub user could not be found.",
            "content": {
              "image/svg+xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
